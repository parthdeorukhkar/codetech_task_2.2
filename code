import pandas as pd
from fpdf import FPDF

# Function to read and analyze data
def read_and_analyze_data(file_path):
    # Read data from the file
    data = pd.read_csv(file_path)

    # Perform basic analysis
    summary = data.describe()  # Summary statistics
    return data, summary

# Function to generate a PDF report
def generate_pdf_report(data, summary, output_file):
    pdf = FPDF()
    pdf.set_auto_page_break(auto=True, margin=15)
    pdf.add_page()

    # Title
    pdf.set_font("Arial", size=16, style='B')
    pdf.cell(200, 10, txt="Data Analysis Report", ln=True, align='C')
    pdf.ln(10)

    # Summary statistics
    pdf.set_font("Arial", size=12)
    pdf.cell(200, 10, txt="Summary Statistics:", ln=True, align='L')
    pdf.ln(5)
    for col in summary.columns:
        pdf.cell(200, 10, txt=f"{col}: {summary[col].to_dict()}", ln=True, align='L')
        pdf.ln(5)

    # Save the PDF
    pdf.output(output_file)

# Main script
if __name__ == "__main__":
    # Input file (replace with your data file)
    input_file = "data.csv"
    output_file = "report.pdf"

    # Read and analyze data
    try:
        data, summary = read_and_analyze_data(input_file)
        print("Data loaded and analyzed successfully.")

        # Generate the PDF report
        generate_pdf_report(data, summary, output_file)
        print(f"Report generated: {output_file}")
    except Exception as e:
        print("Error:", e)
